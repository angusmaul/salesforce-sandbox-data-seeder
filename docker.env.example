# Copy to .env (repo root) for docker compose: cp docker.env.example .env
# Only SESSION_SECRET is required.

# Required: session signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Host port for the frontend (container always listens on 3000). Change if 3000
# is taken. If you change it, set CLIENT_URL below to match the origin you browse to.
WEB_PORT=3000

# Public origins. Defaults suit localhost-only access.
# For LAN/remote access, set BOTH to the host you browse to (CLIENT_URL is used
# for CORS and the Socket.IO origin check; a mismatch breaks live progress):
#   CLIENT_URL=http://192.168.0.50:3000
#   SERVER_URL=http://192.168.0.50:3001
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:3001

# Optional Salesforce OAuth (client-credentials flow can also be entered in the UI)
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Optional: enables AI field classification
ANTHROPIC_API_KEY=

# Prebuilt images only (docker-compose.prebuilt.yml): pin an image version.
# Defaults to latest.
#IMAGE_TAG=1.1.0
