# Copy to .env for local development: cp env.example .env
# All URLs default to localhost — a bare dev setup can leave everything unset.
# For Docker deployment use docker.env.example at the repo root instead.

# Express backend port
PORT=3001

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# Public origins (only needed when browsing from another machine):
# CLIENT_URL is the allowed CORS origin(s), comma-separated for multiple.
# SERVER_URL is the backend's public base URL (used for OAuth callback URIs).
#CLIENT_URL=http://localhost:3000
#SERVER_URL=http://localhost:3001

# Writable state locations (auto-created). Defaults: web/ and <repo>/logs
#DATA_DIR=
#LOGS_DIR=

# Optional server-side Salesforce credentials (the wizard can also take these
# in the UI, where they are saved as reusable connections)
#SF_CLIENT_ID=
#SF_CLIENT_SECRET=

# Optional fallback AI key — providers (Anthropic / OpenAI-compatible / Ollama)
# are normally configured in the wizard's AI settings
#ANTHROPIC_API_KEY=
