# Express backend (server/demo-server.js) — plain JS, no build step.
# Build context: the web/ directory.

# ---- deps ----
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# ---- runtime ----
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3001 \
    DATA_DIR=/data \
    LOGS_DIR=/logs

# Non-root user; /data and /logs are volume mount points it must own
RUN addgroup -S app && adduser -S app -G app \
    && mkdir -p /data /logs && chown -R app:app /data /logs

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY server ./server

USER app
EXPOSE 3001
VOLUME ["/data", "/logs"]

# Node runs as PID 1 and handles SIGTERM itself (explicit handler in demo-server.js).
# Compose sets init:true as a safety net for signal forwarding.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:3001/api/health || exit 1
CMD ["node", "server/demo-server.js"]
