# Install to /etc/sf-seed/sf-seed.env (chown sfseed, chmod 600 — holds a secret).
# systemd EnvironmentFile format: KEY=value, one per line, no quotes, no `export`.
# PORT / HOSTNAME / DATA_DIR / LOGS_DIR are set in the .service unit files.

# Required: session signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Set these to the address you browse to. CLIENT_URL is used for CORS and the
# Socket.IO origin check — if it does not match the browser origin, live progress
# updates break. Example for an LXC at 192.168.0.60:
#   CLIENT_URL=http://192.168.0.60:3000
#   SERVER_URL=http://192.168.0.60:3001
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:3001

# Optional Salesforce OAuth (client-credentials flow can also be entered in the UI)
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Optional: enables AI field classification
ANTHROPIC_API_KEY=
